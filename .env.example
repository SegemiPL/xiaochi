# Copy this file to the repository-root .env and fill in your own keys.
# Existing process environment variables take precedence. Restart Web after edits.

# Required for default chat, DeepSeek native search and narration preparation.
DEEPSEEK_API_KEY=

# Optional: Fish answer narration. Leave empty for text-only use.
FISH_AUDIO_API_KEY=

# Optional: only needed when launching chat with --provider kimi.
# MOONSHOT_API_KEY=

# Optional: server-side Fish key file instead of the value above.
# FISH_AUDIO_API_KEY_FILE=/absolute/path/fish-api-key.txt
# FISH_VOICE_ID=0d6320cfd92647df829a687a7b586f8a
# FISH_VOICE_NAME=政策解读女声

# Web's loopback ASR target. ASR itself must be started separately.
# VOICE_ASR_URL=http://127.0.0.1:8772
# start-asr.sh does NOT load .env; use exports or .local/voice.json for its paths.

# Only scripts/start-web.sh reads these startup options.
# XIAOCHI_PORT=8000
# DEEPSEEK_API_KEY_FILE=/absolute/path/deepseek-api-key.txt

# Optional native search overrides; independent of the chat model in llm.yaml.
# DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash
# DEEPSEEK_SEARCH_TIMEOUT_SECONDS=120

# Optional proxy settings; keep local Web and ASR requests direct.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
